#
# Config options for config.common.ppc64el automatically generated by splitconfig.pl
#
CONFIG_ARCH_MMAP_RND_BITS=18
CONFIG_ARCH_MMAP_RND_BITS_MAX=29
CONFIG_ARCH_MMAP_RND_BITS_MIN=14
CONFIG_ARCH_MMAP_RND_COMPAT_BITS=8
CONFIG_ARCH_MMAP_RND_COMPAT_BITS_MAX=13
CONFIG_ARCH_MMAP_RND_COMPAT_BITS_MIN=7
CONFIG_ATA_GENERIC=m
CONFIG_ATA_PIIX=m
CONFIG_BCH=m
CONFIG_CC_VERSION_TEXT="powerpc64le-linux-gnu-gcc (Ubuntu 11.2.0-16ubuntu1) 11.2.0"
CONFIG_CMA=y
CONFIG_CMM=m
# CONFIG_CPU_BIG_ENDIAN is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
CONFIG_CRC8=m
CONFIG_CRYPTO_LIB_POLY1305_RSIZE=1
CONFIG_DEFAULT_MMAP_MIN_ADDR=65536
CONFIG_DMA_VIRTUAL_CHANNELS=m
# CONFIG_DRM_ETNAVIV is not set
CONFIG_DRM_PANEL_ORIENTATION_QUIRKS=m
CONFIG_FORCE_MAX_ZONEORDER=9
# CONFIG_HIBERNATION is not set
CONFIG_HZ=250
# CONFIG_HZ_100 is not set
# CONFIG_HZ_1000 is not set
CONFIG_HZ_250=y
# CONFIG_I2C_SLAVE is not set
CONFIG_ILLEGAL_POINTER_VALUE=0x5deadbeef0000000
# CONFIG_IOMMU_DEFAULT_DMA_LAZY is not set
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
CONFIG_IOMMU_IOVA=m
CONFIG_IRQ_BYPASS_MANAGER=y
CONFIG_KERNEL_GZIP=y
CONFIG_KVM=y
# CONFIG_LATENCYTOP is not set
CONFIG_MCTP=y
CONFIG_MDIO_BUS_MUX=m
# CONFIG_MEM_SOFT_DIRTY is not set
CONFIG_MII=m
CONFIG_MMC_BLOCK=m
# CONFIG_MMC_HSQ is not set
CONFIG_MTD=m
CONFIG_MTD_NAND_CORE=m
CONFIG_MTD_RAW_NAND=m
CONFIG_NODES_SHIFT=8
CONFIG_NR_CPUS=256
CONFIG_NVRAM=y
CONFIG_OF=y
# CONFIG_PAGE_EXTENSION is not set
CONFIG_PAGE_OFFSET=0xc000000000000000
CONFIG_PATA_SIS=m
# CONFIG_PCMCIA is not set
CONFIG_PGTABLE_LEVELS=4
CONFIG_PHYSICAL_START=0x00000000
# CONFIG_PREEMPT is not set
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_REGULATOR_FIXED_VOLTAGE=m
CONFIG_RTC_DRV_CMOS=m
CONFIG_SERIAL_8250_DW=m
CONFIG_SND_HDA_PREALLOC_SIZE=64
CONFIG_STANDALONE=y
CONFIG_TCG_TIS_CORE=y
CONFIG_TOUCHSCREEN_ELAN=m
CONFIG_USB_EHCI_HCD_PLATFORM=m
CONFIG_USB_OHCI_HCD_PLATFORM=m
CONFIG_VFIO_PCI=y
CONFIG_VFIO_PCI_CORE=y
CONFIG_VFIO_VIRQFD=y
# CONFIG_VIRT_CPU_ACCOUNTING_NATIVE is not set
