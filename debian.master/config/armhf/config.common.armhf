#
# Config options for config.common.armhf automatically generated by splitconfig.pl
#
CONFIG_ARCH_MMAP_RND_BITS=8
CONFIG_ARCH_MMAP_RND_BITS_MAX=16
CONFIG_ARCH_MMAP_RND_BITS_MIN=8
CONFIG_ARCH_NR_GPIO=2048
CONFIG_ATA_GENERIC=m
CONFIG_ATA_PIIX=m
CONFIG_BCH=y
CONFIG_CC_VERSION_TEXT="arm-linux-gnueabihf-gcc (Ubuntu 11.2.0-16ubuntu1) 11.2.0"
CONFIG_CMA=y
# CONFIG_COMMON_CLK_AXG_AUDIO is not set
# CONFIG_CPU_BIG_ENDIAN is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
CONFIG_CRC8=y
CONFIG_CRYPTO_LIB_POLY1305_RSIZE=9
CONFIG_DEFAULT_MMAP_MIN_ADDR=32768
CONFIG_DMA_VIRTUAL_CHANNELS=y
CONFIG_DRM_ETNAVIV=m
CONFIG_DRM_PANEL_ORIENTATION_QUIRKS=y
CONFIG_FORCE_MAX_ZONEORDER=14
# CONFIG_FSL_MC_BUS is not set
CONFIG_HIBERNATION=y
CONFIG_HZ=250
# CONFIG_HZ_100 is not set
# CONFIG_HZ_1000 is not set
CONFIG_HZ_250=y
CONFIG_I2C_SLAVE=y
# CONFIG_IOMMU_DEFAULT_DMA_LAZY is not set
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
CONFIG_IOMMU_IOVA=m
CONFIG_IRQ_BYPASS_MANAGER=m
CONFIG_KERNEL_GZIP=y
# CONFIG_LATENCYTOP is not set
CONFIG_MCTP=y
CONFIG_MDIO_BUS_MUX=m
CONFIG_MII=y
CONFIG_MMC_BLOCK=y
# CONFIG_MMC_HSQ is not set
CONFIG_MTD=y
CONFIG_MTD_NAND_CORE=y
CONFIG_MTD_RAW_NAND=y
CONFIG_NR_CPUS=4
CONFIG_OF=y
CONFIG_PAGE_EXTENSION=y
CONFIG_PAGE_OFFSET=0xC0000000
CONFIG_PATA_SIS=m
# CONFIG_PCMCIA is not set
CONFIG_PHY_TI_GMII_SEL=y
# CONFIG_PREEMPT is not set
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_RTC_DRV_CMOS=m
CONFIG_SERIAL_8250_DW=m
CONFIG_SND_HDA_PREALLOC_SIZE=64
CONFIG_STANDALONE=y
CONFIG_TCG_TIS_CORE=y
CONFIG_TOUCHSCREEN_ELAN=m
CONFIG_USB_EHCI_HCD_PLATFORM=m
CONFIG_USB_OHCI_HCD_PLATFORM=m
CONFIG_VFIO_PCI=m
CONFIG_VFIO_PCI_CORE=m
CONFIG_VFIO_VIRQFD=m
